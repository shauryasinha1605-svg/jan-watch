# Optional Gemini integration. Without these values, the app uses a labelled rule-based classifier.
GEMINI_API_KEY=AQ.Ab8RN6L_Rov0G8_gi1r3tqY4Ki3-PbO4ydB1F0YANh-zfLS41A
GEMINI_MODEL=gemini-3.8-flash

# Change this before sharing a deployed demo. Demo mode uses this to sign its session cookie.
JANWATCH_SESSION_SECRET=replace-with-a-long-random-secret

# Optional production migration target (schema is in supabase/migrations).
# The current prototype persists to local JSON for zero-setup local demos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
